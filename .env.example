# Copy to .env.local for local dev. Without these, the site still runs —
# pricing uses the built-in snapshot and booking/availability return errors.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional — bookings still save without it)
RESEND_API_KEY=
OWNER_EMAIL=
FROM_EMAIL=
